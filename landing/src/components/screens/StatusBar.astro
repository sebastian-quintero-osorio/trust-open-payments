---
// iOS-style status bar for the 390×844pt mock canvas: "9:41" in the left ear, signal/wifi/battery in the right ear.
---

<div class="sk-status">
  <span class="sk-status__time">9:41</span>
  <span class="sk-status__island"></span>
  <span class="sk-status__icons">
    <svg class="sk-status__signal" viewBox="0 0 18 12" fill="currentColor" aria-hidden="true">
      <rect x="0" y="8" width="3.2" height="4" rx="1"></rect>
      <rect x="4.9" y="5.5" width="3.2" height="6.5" rx="1"></rect>
      <rect x="9.8" y="3" width="3.2" height="9" rx="1"></rect>
      <rect x="14.7" y="0" width="3.2" height="12" rx="1"></rect>
    </svg>
    <svg class="sk-status__wifi" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
      <path d="M1.4 4.4a9.2 9.2 0 0 1 13.2 0"></path>
      <path d="M4 7.1a5.5 5.5 0 0 1 8 0"></path>
      <circle cx="8" cy="10" r="1.5" fill="currentColor" stroke="none"></circle>
    </svg>
    <svg class="sk-status__battery" viewBox="0 0 27 13" fill="none" aria-hidden="true">
      <rect x="0.5" y="0.5" width="23" height="12" rx="3.6" stroke="currentColor" stroke-opacity="0.4"></rect>
      <rect x="2.2" y="2.2" width="19.6" height="8.6" rx="2.2" fill="currentColor"></rect>
      <rect x="24.8" y="4.3" width="1.7" height="4.4" rx="0.85" fill="currentColor" fill-opacity="0.45"></rect>
    </svg>
  </span>
</div>
