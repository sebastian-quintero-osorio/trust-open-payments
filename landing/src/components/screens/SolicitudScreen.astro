---
// Mock of the app screen "Solicitar crédito" (screenId solicitud-credito), COPY.md §13b. Section Comercios.
// Rendered inside <DeviceFrame> (390×844pt canvas, sizes in var(--pt)). Decorative: no focusable elements.
import './screen-kit.css';
import StatusBar from './StatusBar.astro';
import Num from './Num.astro';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Info from '@lucide/astro/icons/info';
import Handshake from '@lucide/astro/icons/handshake';
import ChevronRight from '@lucide/astro/icons/chevron-right';

// Range scale: $500.000 → $6.000.000 (COPY.md). Thumbs at $1.500.000 and $3.000.000.
const MIN = 500000;
const MAX = 6000000;
const pos = (v: number) => `${(((v - MIN) / (MAX - MIN)) * 100).toFixed(3)}%`;
const lo = pos(1500000);
const hi = pos(3000000);
const span = `${(((3000000 - 1500000) / (MAX - MIN)) * 100).toFixed(3)}%`;
---

<div class="sk-screen sol" data-screen="solicitud-credito" style={`--lo: ${lo}; --hi: ${hi}; --span: ${span};`}>
  <StatusBar />

  <div class="sk-body sol__body">
    <div class="sol__nav">
      <div class="sk-iconbtn"><span class="sk-ico" style="--s: 22"><ChevronLeft stroke-width={2} /></span></div>
      <span class="sk-title">Solicitar crédito</span>
      <span class="sol__nav-spacer"></span>
    </div>

    <div class="sol__step">
      <span class="sk-cap">Paso 2 de 3 · <span class="sk-strong">Monto</span></span>
      <div class="sol__steps">
        <span class="is-done"></span><span class="is-done"></span><span></span>
      </div>
    </div>

    <div class="sk-chip sol__cupo">
      <span class="sk-ico sk-accent" style="--s: 15"><ShieldCheck stroke-width={2} /></span>
      Tu cupo: <span class="sk-money">$6.000.000</span>
    </div>

    <div class="sk-card sol__range">
      <span class="sk-label">Tu rango</span>
      <div class="sol__values">
        <div class="sol__value">
          <span class="sk-micro">Mínimo</span>
          <span class="sk-amt sk-amt--sm">$1.500.000</span>
        </div>
        <span class="sol__dash"></span>
        <div class="sol__value sol__value--hi">
          <span class="sk-micro">Máximo</span>
          <span class="sk-amt sk-amt--sm">$3.000.000</span>
        </div>
      </div>
      <div class="sol__slider">
        <div class="sol__track">
          <span class="sol__fill" data-anim="fill-x" style="--d: 250ms; --t: 1300ms"></span>
          <span class="sol__knob sol__knob--lo"><span class="sol__thumb"></span></span>
          <span class="sol__knob sol__knob--hi" data-anim="slide"><span class="sol__thumb sol__thumb--hi sk-loop"></span></span>
        </div>
        <div class="sk-row sol__scale">
          <span class="sk-micro">$500.000</span>
          <span class="sk-micro">$6.000.000</span>
        </div>
      </div>
    </div>

    <div class="sk-card sol__pct">
      <span class="sk-label">Porcentaje de tus ventas para abonar</span>
      <div class="sol__seg">
        <span class="sol__seg-ind" data-anim="seg"></span>
        <span class="sol__seg-opt">10&nbsp;%</span>
        <span class="sol__seg-opt is-on">15&nbsp;%</span>
        <span class="sol__seg-opt">20&nbsp;%</span>
      </div>
      <span class="sk-divider sol__div"></span>
      <div class="sol__preview-head">
        <span class="sk-overline">Vista previa</span>
      </div>
      <p class="sol__preview">
        Con 15&nbsp;%, una venta de <span class="sk-money">$48.000</span> abona
        <Num value={7200} delay={900} class="sk-money sk-accent" /> y te quedan <Num
          value={40800}
          delay={900}
          class="sk-money"
        />.
      </p>
    </div>

    <div class="sol__note">
      <span class="sk-ico" style="--s: 15"><Info stroke-width={2} /></span>
      <span>Las condiciones finales se acuerdan con el prestamista antes de aceptar.</span>
    </div>

    <div class="sk-bottom sol__actions">
      <div class="sol__match" data-anim="pop" style="--d: 1500ms; --t: 700ms">
        <span class="sk-ico" style="--s: 15"><Handshake stroke-width={2} /></span>
        <span><span class="sk-strong">3 ofertas</span> encajan con tu rango</span>
      </div>
      <div class="sk-btn">Publicar solicitud</div>
      <div class="sk-link sol__secondary">
        Ver ofertas que encajan
        <span class="sk-ico" style="--s: 16"><ChevronRight stroke-width={2} /></span>
      </div>
    </div>
  </div>
  <span class="sk-home"></span>
</div>

<style>
  .sol__body {
    padding-block: calc(var(--pt) * 6) calc(var(--pt) * 36);
  }

  .sol__nav {
    display: grid;
    grid-template-columns: calc(var(--pt) * 40) 1fr calc(var(--pt) * 40);
    align-items: center;
    text-align: center;
  }

  .sol__step {
    display: flex;
    flex-direction: column;
    gap: calc(var(--pt) * 8);
    margin-block-start: calc(var(--pt) * 14);
  }

  .sol__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(var(--pt) * 6);
  }

  .sol__steps > span {
    block-size: calc(var(--pt) * 4);
    border-radius: 999px;
    background: var(--sk-track);
  }

  .sol__steps > .is-done {
    background: linear-gradient(90deg, var(--trust-violet), var(--trust-violet-400));
    box-shadow: 0 0 calc(var(--pt) * 8) rgb(105 48 249 / 0.6);
  }

  .sol__cupo {
    align-self: flex-start;
    margin-block-start: calc(var(--pt) * 18);
    block-size: calc(var(--pt) * 30);
    font-size: calc(var(--pt) * 13);
  }

  .sol__range,
  .sol__pct {
    display: flex;
    flex-direction: column;
    margin-block-start: calc(var(--pt) * 12);
    padding: calc(var(--pt) * 18);
  }

  .sol__values {
    display: grid;
    grid-template-columns: 1fr calc(var(--pt) * 14) 1fr;
    align-items: center;
    gap: calc(var(--pt) * 8);
    margin-block-start: calc(var(--pt) * 12);
  }

  .sol__value {
    display: flex;
    flex-direction: column;
    gap: calc(var(--pt) * 6);
    padding: calc(var(--pt) * 10) calc(var(--pt) * 12);
    border-radius: calc(var(--pt) * 14);
    background: rgb(241 233 253 / 0.04);
    border: 1px solid var(--sk-line);
  }

  .sol__value--hi {
    background: rgb(105 48 249 / 0.14);
    border-color: rgb(180 153 254 / 0.28);
  }

  .sol__dash {
    block-size: 1px;
    background: var(--sk-line-strong);
  }

  .sol__slider {
    margin-block-start: calc(var(--pt) * 14);
  }

  .sol__track {
    position: relative;
    block-size: calc(var(--pt) * 28);
    margin-inline: calc(var(--pt) * 12);
  }

  /* rail + $500.000 tick marks */
  .sol__track::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(50% - var(--pt) * 3);
    block-size: calc(var(--pt) * 6);
    border-radius: 999px;
    background: var(--sk-track);
  }

  .sol__track::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(50% + var(--pt) * 7);
    block-size: calc(var(--pt) * 4);
    background: repeating-linear-gradient(90deg, rgb(241 233 253 / 0.22) 0 1px, transparent 1px calc((100% - 1px) / 11));
  }

  .sol__fill {
    position: absolute;
    inset-block-start: calc(50% - var(--pt) * 3);
    inset-inline-start: var(--lo);
    inline-size: var(--span);
    block-size: calc(var(--pt) * 6);
    border-radius: 999px;
    background: linear-gradient(90deg, var(--trust-violet), var(--trust-violet-400));
    box-shadow: 0 0 calc(var(--pt) * 12) rgb(105 48 249 / 0.85);
  }

  .sol__knob {
    position: absolute;
    inset: 0;
    transform: translateX(var(--lo));
  }

  .sol__knob--hi {
    transform: translateX(var(--hi));
  }

  .sol__thumb {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    inline-size: calc(var(--pt) * 24);
    block-size: calc(var(--pt) * 24);
    margin: calc(var(--pt) * -12) 0 0 calc(var(--pt) * -12);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #fff, var(--trust-lilac) 70%);
    box-shadow:
      0 0 0 calc(var(--pt) * 4) rgb(105 48 249 / 0.55),
      0 calc(var(--pt) * 4) calc(var(--pt) * 14) rgb(0 0 0 / 0.5);
  }

  /* soft halo on the max thumb (loop) */
  .sol__thumb--hi::after {
    content: '';
    position: absolute;
    inset: calc(var(--pt) * -10);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(157 103 251 / 0.55), rgb(157 103 251 / 0));
    opacity: 0.7;
  }

  @keyframes sol-halo {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .sol__scale {
    margin-block-start: calc(var(--pt) * 10);
  }

  .sol__seg {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    block-size: calc(var(--pt) * 44);
    margin-block-start: calc(var(--pt) * 12);
    padding: calc(var(--pt) * 4);
    border-radius: 999px;
    background: rgb(241 233 253 / 0.05);
    border: 1px solid var(--sk-line);
  }

  .sol__seg-ind {
    position: absolute;
    inset-block: calc(var(--pt) * 4);
    inset-inline-start: calc(var(--pt) * 4);
    inline-size: calc((100% - var(--pt) * 8) / 3);
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0) 60%),
      var(--trust-violet);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 calc(var(--pt) * 6) calc(var(--pt) * 18) calc(var(--pt) * -4) rgb(105 48 249 / 0.85);
    transform: translateX(100%);
  }

  .sol__seg-opt {
    position: relative;
    display: grid;
    place-items: center;
    font-size: calc(var(--pt) * 15);
    font-weight: 500;
    color: var(--sk-muted);
  }

  .sol__seg-opt.is-on {
    font-weight: 650;
    color: #fff;
  }

  .sol__div {
    margin-block: calc(var(--pt) * 16) calc(var(--pt) * 14);
  }

  .sol__preview-head {
    display: flex;
    align-items: center;
    gap: calc(var(--pt) * 8);
  }

  .sol__preview {
    margin-block-start: calc(var(--pt) * 8);
    font-size: calc(var(--pt) * 14.5);
    line-height: 1.45;
    color: var(--sk-muted);
    text-wrap: pretty;
  }

  .sol__note {
    display: flex;
    gap: calc(var(--pt) * 8);
    margin-block-start: calc(var(--pt) * 14);
    padding-inline: calc(var(--pt) * 4);
    font-size: calc(var(--pt) * 12);
    line-height: 1.4;
    color: var(--sk-subtle);
  }

  .sol__note .sk-ico {
    margin-block-start: calc(var(--pt) * 1);
  }

  .sol__actions {
    display: flex;
    flex-direction: column;
    gap: calc(var(--pt) * 10);
  }

  .sol__match {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--pt) * 7);
    margin-block-end: calc(var(--pt) * 4);
    font-size: calc(var(--pt) * 13);
    color: var(--sk-muted);
  }

  .sol__match .sk-ico {
    color: var(--sk-accent);
  }

  .sol__secondary {
    align-self: center;
    block-size: calc(var(--pt) * 30);
  }

  /* one-shot: max thumb travels from the min position while the fill grows; selector slides 10 % → 15 % */
  .sol [data-anim='slide'],
  .sol [data-anim='seg'] {
    transition: transform 1300ms var(--sk-ease) 250ms;
  }

  .sol [data-anim='seg'] {
    transition-duration: 700ms;
    transition-delay: 1000ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .sol:not(.is-played) [data-anim='slide'] {
      transform: translateX(var(--lo));
    }

    :global(.js) .sol:not(.is-played) [data-anim='seg'] {
      transform: translateX(0);
    }
  }

  /* no halo on the thumb (no testigos) */
  .sol__thumb--hi::after {
    display: none;
  }
</style>
