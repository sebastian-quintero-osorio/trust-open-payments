# Copiar a op-service.env (chmod 600); no versionar claves reales.
# La clave debe estar registrada en Developer Keys de esta wallet.
OP_CLIENT_WALLET_ADDRESS=
OP_KEY_ID=
OP_PRIVATE_KEY=''
POOL_WALLET_ADDRESSES=
# Solo habilitar la simulación si se ha configurado un pagador de pruebas.
SIM_ENABLED=false
