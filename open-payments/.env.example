# Copiar a .env y reemplazar los marcadores. Nunca publicar credenciales reales.
# Demo sin dominio: python3 scripts/demo.py
# Validar configuración sin pagos: python3 scripts/demo.py --check

# PostgreSQL: Compose construye DATABASE_URL a partir de estas variables.
POSTGRES_USER=op_service
POSTGRES_DB=op_service
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
# Solo al ejecutar Go fuera de Compose:
# DATABASE_URL=postgres://op_service:CHANGE_ME@localhost:5432/op_service?sslmode=disable

# Secreto compartido con el backend Trust. Generar con: openssl rand -hex 32
# Encabezado HTTP: X-Internal-Api-Key
INTERNAL_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Open Payments: wallet cliente Trust y clave registrada en Developer Keys.
OP_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/CHANGE_ME_TRUST
OP_KEY_ID=CHANGE_ME_REGISTERED_KEY_ID
# Sustituir por el PEM PKCS#8 Ed25519 completo entre comillas simples,
# con saltos reales, desde BEGIN PRIVATE KEY hasta END PRIVATE KEY.
OP_PRIVATE_KEY='CHANGE_ME_PKCS8_ED25519_PEM'

# Una wallet de recaudo para la demo; puede ser la wallet cliente Trust.
# Para varias wallets, separar las URLs completas por comas.
POOL_WALLET_ADDRESSES=https://ilp.interledger-test.dev/CHANGE_ME_TRUST

# scripts/demo.py configura automáticamente estas opciones para cada sesión.
# Fuera del script, PUBLIC_BASE_URL debe ser HTTPS y accesible al navegador.
DEMO_MODE=false
PUBLIC_BASE_URL=https://pay.example
# Sin frontend: el modo demo usa PUBLIC_BASE_URL/v1/health como retorno.
# Fuera del modo demo, configurar explícitamente el retorno HTTPS del frontend.
ALLOWED_RETURN_URL_PREFIXES=
# Opcional. La demo ignora las cabeceras de IP y no requiere CIDR.
TRUSTED_PROXY_CIDRS=
# Solo con dominio propio y el despliegue de producción mediante Caddy.
PAY_DOMAIN=pay.example

# Ventas QR: activar al configurar el pagador y el webhook real de Trust.
# Pagador y recaudo deben pertenecer a usuarios distintos con el mismo asset.
SIM_ENABLED=false
SIM_PAYER_WALLET_ADDRESS=
SIM_MAX_AMOUNT=50000
TRUST_WEBHOOK_URL=
# Generar con openssl rand -hex 32 y compartir con el receptor del webhook.
TRUST_WEBHOOK_SECRET=
INTERACTION_TIMEOUT_SECONDS=600
POLL_INTERVAL_SECONDS=2

# Opcional: aceptación aislada con scripts/live-smoke.py demo.
# Usar --manual-distribution solo si el backend NO reparte estas ventas.
# DEMO_LENDER_WALLET_ADDRESS=https://ilp.interledger-test.dev/CHANGE_ME_LENDER
# DEMO_MERCHANT_WALLET_ADDRESS=https://ilp.interledger-test.dev/CHANGE_ME_MERCHANT
# DEMO_TRUST_INCOME_WALLET_ADDRESS=https://ilp.interledger-test.dev/CHANGE_ME_INCOME
# DEMO_CREDIT_VALUE=10000
# DEMO_SALE_VALUE=4800
