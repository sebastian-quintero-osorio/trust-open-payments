# Copiar a .env y ajustar (cp .env.example .env). Nunca commitear .env.
# Variables de la tabla "Configuración" de specs/00-core.md; las que quedan vacías no tienen default.
# Montos en unidades mínimas del asset de mercado (centavos de COP con escala 2) y porcentajes en bps.

# ── Base de datos y auth ──────────────────────────────────────────────────────
# Fuera de Docker (uv run uvicorn ...): el Postgres de `docker compose up -d db` publicado en localhost:5433.
# En `docker compose up` la API ignora este valor y usa db:5432 (ver TRUST_API_DATABASE_URL más abajo).
DATABASE_URL=postgresql+psycopg://trust:trust@localhost:5433/trust_dev
# Obligatorio, mínimo 32 caracteres; sin él la API no arranca. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_HOURS=168
CORS_ORIGINS=http://localhost:3000,https://trustservices.com.co,https://app.trustservices.com.co
TIMEZONE=America/Bogota

# ── Asset único del mercado ───────────────────────────────────────────────────
MARKET_ASSET_CODE=COP
MARKET_ASSET_SCALE=2

# ── op-service (spec 02) ──────────────────────────────────────────────────────
# fake = cliente en memoria (demo sin Go); http = op-service real (Go) o el mock de tools/mock_op_service.
OP_CLIENT=fake
# Con OP_CLIENT=http: URL base de op-service (sin /v1) y el valor de su INTERNAL_API_KEY (header X-Internal-Api-Key).
OP_SERVICE_BASE_URL=
OP_SERVICE_API_KEY=
OP_HTTP_TIMEOUT_SECONDS=10
OP_FAKE_AUTO_COMPLETE=true
# URL pública de esta API: base del authorization_url de la wallet falsa (OP_CLIENT=fake).
PUBLIC_API_URL=http://localhost:8000

# ── Webhook de Puntored (spec 07) ─────────────────────────────────────────────
# Secretos HMAC aceptados en X-Puntored-Signature, separados por coma (rotación). El mismo valor que el
# TRUST_WEBHOOK_SECRET de op-service. Generar con: openssl rand -hex 32
PUNTORED_WEBHOOK_SECRETS=
NOTIFY_SALE_SPLIT=true

# ── Parte de Trust (specs 05 y 07) ────────────────────────────────────────────
# Wallet que recibe la parte Trust de cada abono (en el asset de mercado). Vacía: esas patas quedan retenidas.
TRUST_REVENUE_WALLET_ADDRESS=
TRUST_SHARE_BPS=2000
TRUST_LEG_MIN=10000
TRUST_CUT_POLICY=prorated

# ── Créditos: montos y porcentajes ────────────────────────────────────────────
MIN_LOAN_AMOUNT=50000000
AMOUNT_STEP=5000000
CUPO_CAP=1000000000
PCT_OPTIONS_BPS=1000,1500,2000

# Términos y recálculo del %
DEFAULT_TERM_MONTHS=3
REPRICE_STEP_BPS=250
REPRICE_MAX_DELTA_BPS=500

# ── Scoring (specs 05 y 09) ───────────────────────────────────────────────────
MIN_MONTHS=3
SCORING_POLICY=v1
MIN_SALES_PER_MONTH=10
SCORE_VOLUME_REF=1000000000

# ── Créditos pendientes y app web ─────────────────────────────────────────────
PENDING_LOAN_TTL_HOURS=48
# Base del return_url del desembolso (la app web recibe /op/return?loan_id=...&op_status=...).
APP_WEB_URL=https://app.trustservices.com.co

# ── Worker (spec 08) ──────────────────────────────────────────────────────────
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=2

# ── Demo y landing (specs 03 y 15) ────────────────────────────────────────────
# true habilita /dev/* (seed, simular ventas, wallet falsa). Nunca en producción con datos reales.
DEV_ENDPOINTS_ENABLED=false
DEMO_PASSWORD=trust2026
DEMO_MERCHANT_WALLET_URL=https://ilp.interledger-test.dev/demo-marta
DEMO_LENDER_WALLET_URL=https://ilp.interledger-test.dev/demo-camilo
LANDING_URL=https://trustservices.com.co

# ── docker compose (no los lee la API: los interpola docker-compose.yml) ──────
# Puerto del host donde se publica la API (contenedor :8000).
# TRUST_API_PORT=8000
# DATABASE_URL de la API dentro de compose (por defecto el servicio db de compose).
# TRUST_API_DATABASE_URL=postgresql+psycopg://trust:trust@db:5432/trust_dev

# ── Tests (pytest; conftest no lee este archivo, solo el entorno) ─────────────
# TEST_DATABASE_URL=postgresql+psycopg://trust:trust@localhost:5433/trust_test

# ── Ejemplo: Trust contra el mock de op-service (tools/mock_op_service/README.md) ──
# El mock no lee este archivo; arráncalo con sus propias variables (INTERNAL_API_KEY, TRUST_WEBHOOK_URL,
# TRUST_WEBHOOK_SECRET). Si la API corre en Docker y el mock en el host, usa host.docker.internal.
# OP_CLIENT=http
# OP_SERVICE_BASE_URL=http://localhost:8090
# OP_SERVICE_API_KEY=dev-internal-api-key
# PUNTORED_WEBHOOK_SECRETS=dev-webhook-secret
